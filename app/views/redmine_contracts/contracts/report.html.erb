<div class="contextual">
  <%= link_to l(:button_back),
              {
                controller: 'redmine_contracts/contracts',
                action: 'show',
                project_id: @project,
                id: @contract
              },
              class: 'icon icon-cancel' %>
</div>

<%= title "#{l(:label_redmine_contract_hours_report)}: #{@contract.name}" %>

<div class="box tabular">
  <p><strong><%= l(:label_redmine_contract_report_from) %>:</strong> <%= format_date(@contract.started_on) %></p>

  <%= form_tag({ controller: 'redmine_contracts/contracts', action: 'report', project_id: @project, id: @contract }, method: :get) do %>
    <p>
      <label><%= l(:label_redmine_contract_group_by_time) %></label>
      <%= select_tag :time_group_by,
                     options_for_select(
                       [
                         [l(:label_redmine_contract_group_week), 'week'],
                         [l(:label_redmine_contract_group_month), 'month']
                       ],
                       @time_group_by
                     ) %>
      <label><%= l(:label_redmine_contract_group_by_secondary) %></label>
      <%= select_tag :detail_group_by,
                     options_for_select(
                       [
                         [l(:label_redmine_contract_group_bonus), 'bonus'],
                         [l(:label_redmine_contract_group_project), 'project']
                       ],
                       @detail_group_by
                     ) %>
      <label><%= l(:label_redmine_contract_bonus_filter) %></label>
      <%= select_tag :bonus_id,
                     options_for_select(
                       [[l(:label_redmine_contract_all_bonuses), '']] +
                       @available_report_bonuses.map do |bonus|
                         ["#{bonus.name} (#{format_date(bonus.awarded_on)})", bonus.id]
                       end,
                       @selected_report_bonus_id
                     ) %>
      <%= hidden_field_tag :include_comments, '0' %>
      <label class="inline">
        <%= check_box_tag :include_comments, '1', @include_comments %>
        <%= l(:label_redmine_contract_include_comments) %>
      </label>
      <%= submit_tag l(:button_apply) %>
    </p>
  <% end %>
</div>

<% if @report_rows.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <% column_count = @include_comments ? 7 : 6 %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_date) %></th>
        <th><%= l(:field_project) %></th>
        <th><%= l(:field_issue) %></th>
        <th><%= l(:field_fixed_version) %></th>
        <th><%= l(:label_redmine_contract_bonus_name) %></th>
        <th><%= l(:field_hours) %></th>
        <% if @include_comments %>
          <th><%= l(:field_comments) %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @grouped_report_rows.each do |group| %>
        <% if group[:show_label] %>
          <tr class="group open">
            <td colspan="<%= column_count %>">
              <strong><%= group[:label] %></strong>
              (<%= l(:label_redmine_contract_total_hours) %>: <%= format_contract_hours(group[:total_hours]) %>)
            </td>
          </tr>
        <% end %>
        <% group[:subgroups].each do |subgroup| %>
          <% if subgroup[:show_label] %>
            <tr class="group open">
              <td colspan="<%= column_count %>">
                <strong><%= subgroup[:label] %></strong>
                (<%= l(:label_redmine_contract_total_hours) %>: <%= format_contract_hours(subgroup[:total_hours]) %>)
              </td>
            </tr>
          <% end %>
          <% subgroup[:rows].each do |row| %>
            <% issue = row[:issue] %>
            <tr>
              <td><%= format_date(row[:date]) %></td>
              <td><%= row[:project]&.name || '-' %></td>
              <td>
                <% if issue %>
                  <%= link_to "##{issue.id} #{issue.subject}",
                              issue_path(issue) %>
                <% else %>
                  -
                <% end %>
              </td>
              <td><%= row[:version]&.name || '-' %></td>
              <td><%= row[:bonus_label].presence || '-' %></td>
              <td><%= format_contract_hours(row[:hours]) %></td>
              <% if @include_comments %>
                <td><%= row[:time_entry]&.comments.presence || '-' %></td>
              <% end %>
            </tr>
            <% end %>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>

<% other_formats_links do |f| %>
  <%= f.link_to_with_query_parameters 'CSV', format: 'csv' %>
  <%= f.link_to_with_query_parameters 'PDF', format: 'pdf' %>
<% end %>
