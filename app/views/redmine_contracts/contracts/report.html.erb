<div class="contextual">
  <%= link_to l(:button_back),
              {
                controller: 'redmine_contracts/contracts',
                action: 'show',
                project_id: @project,
                id: @contract
              },
              class: 'icon icon-cancel' %>
</div>

<%= title "#{l(:label_redmine_contract_hours_report)}: #{@contract.name}" %>

<div class="box tabular">
  <p><strong><%= l(:label_redmine_contract_report_from) %>:</strong> <%= format_date(@contract.started_on) %></p>

  <%= form_tag({ controller: 'redmine_contracts/contracts', action: 'report', project_id: @project, id: @contract }, method: :get) do %>
    <p>
      <label><%= l(:label_redmine_contract_group_by) %></label>
      <%= select_tag :group_by,
                     options_for_select(
                       [
                         [l(:label_redmine_contract_group_none), 'none'],
                         [l(:label_redmine_contract_group_week), 'week'],
                         [l(:label_redmine_contract_group_month), 'month']
                       ],
                       @group_by
                     ) %>
      <%= submit_tag l(:button_apply) %>
    </p>
  <% end %>
</div>

<% if @report_rows.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <table class="list">
    <thead>
      <tr>
        <th><%= l(:field_date) %></th>
        <th><%= l(:field_project) %></th>
        <th><%= l(:field_issue) %></th>
        <th><%= l(:field_fixed_version) %></th>
        <th><%= l(:field_hours) %></th>
      </tr>
    </thead>
    <tbody>
      <% @grouped_report_rows.each do |group| %>
        <% if @group_by != 'none' %>
          <tr class="group open">
            <td colspan="5">
              <strong><%= group[:label] %></strong>
              (<%= l(:label_redmine_contract_total_hours) %>: <%= format_contract_hours(group[:total_hours]) %>)
            </td>
          </tr>
        <% end %>
        <% group[:rows].each do |row| %>
          <% issue = row[:issue] %>
          <tr>
            <td><%= format_date(row[:date]) %></td>
            <td><%= row[:project]&.name || '-' %></td>
            <td>
              <% if issue %>
                <%= link_to "##{issue.id} #{issue.subject}",
                            issue_path(issue) %>
              <% else %>
                -
              <% end %>
            </td>
            <td><%= row[:version]&.name || '-' %></td>
            <td><%= format_contract_hours(row[:hours]) %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>
